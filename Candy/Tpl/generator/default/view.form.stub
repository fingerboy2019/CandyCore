<form onsubmit="return false;" data-auto="true" action="<{if !empty($vo.{{pk}})}><{:U('edit.json')}><{else}><{:U('add.json')}><{/if}>" method="post" class="layui-form layui-card">
    <div class="layui-card-body">
        <input type="hidden" name="{{pk}}" value="<{$vo.{{pk}}|default:''}>">
{{formFieldsHtml}}
        <div class="hr-line-dashed"></div>
        <div class="layui-form-item text-center">
            <button class="layui-btn" type="submit"><{$lang.save}></button>
            <button class="layui-btn layui-btn-primary" type="button" data-close><{$lang.cancel}></button>
        </div>
    </div>
</form>
